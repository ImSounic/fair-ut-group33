d:linking-2026H1 a prov:Activity ;
    rdfs:label "Attribution of hosts to municipalities"@en ;
    rdfs:comment "Rules version 1.0. 1867 hosts: R1 681, R2 333, R3 44, R4 329, ambiguous 1, not attributed 479 (coverage 74.3%). The municipal set was checked against CBS 2026 (342 codes)."@en ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent d:software-attribute ;
            prov:hadPlan ont:R1-official-host,
                ont:R2-official-domain,
                ont:R3-name-domain,
                ont:R4-name-label ] ;
    prov:used d:export-cbs-gemeenten-2026,
        d:export-wikidata-municipalities,
        d:extracted-tables-2026H1 ;
    prov:wasAssociatedWith d:software-attribute .

