d:export-nora-standards a prov:Entity ;
    rdfs:label "NORA export: standards on the comply-or-explain list"@en ;
    dct:source <https://github.com/ImSounic/fair-ut-group33/blob/main/queries/linking/nora_standards.rq> ;
    spdx:checksum [ a spdx:Checksum ;
            spdx:algorithm spdx:checksumAlgorithm_sha256 ;
