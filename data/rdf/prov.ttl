    prov:generatedAtTime "2026-10-13T17:03:28+00:00"^^xsd:dateTime ;
    prov:hadPrimarySource <https://www.noraonline.nl/> .

d:measurement-2026H1 a prov:Activity ;
    rdfs:label "Measurement of information security standards, begin 2026"@en,
        "Meting Informatieveiligheidstandaarden begin 2026"@nl ;
    dct:source <https://www.forumstandaardisatie.nl/sites/default/files/OBDO/2026/0611/20260611-1a-rapport-meting-informatieveiligheidstandaarden-begin-2026-OBDO.html> ;
    dct:temporal [ a dct:PeriodOfTime ;
            dcat:endDate "2025-12-31"^^xsd:date ] ;
    rdfs:comment "Bulk test of government internet domains through the Internet.nl API. The results reflect the state on 31 December 2025; the source does not state the test dates, so the reference date is used as dct:date of every result."@en ;
    prov:wasAssociatedWith d:forum-standaardisatie,
        d:internetnl .

d:exclusion-2026H1 a prov:Activity ;
    rdfs:label "Exclusion of one host name that contains a personal name"@en ;
    rdfs:comment "One municipal subdomain contains the name of a living person and is left out of all derived data (data minimisation): 1 web and 1 e-mail row. The host is matched by the SHA-256 of its name, so the name is not repeated: 84b089a62db0e1e8ba0482485f91972ae5578569196a4b768d70af651263adbf."@en ;
    prov:wasAssociatedWith d:software-extract ;
    prov:wasInformedBy d:extraction-2026H1 .

