d:internetnl a earl:Software,
        prov:SoftwareAgent ;
    rdfs:comment "Open-source test suite for internet standards, used through its batch API. The release used for this measurement is not stated by the source."@en ;
    prov:actedOnBehalfOf d:forum-standaardisatie ;
    foaf:homepage <https://internet.nl/> ;
    foaf:name "Internet.nl" ;
    schema:sameAs wd:Q138768186 .

d:label-correction-2026H1 a prov:Activity ;
    rdfs:label "Correction of two mislabelled web columns"@en ;
    rdfs:comment "In all 16 web tables of the appendix, columns 3 and 4 are labelled 'IPv6 web' and 'RPKI web', repeating the labels of columns 6 and 7. They are relabelled 'HTTPS redirect' and 'HSTS': the legend lists the web tests in that order; the duplicated columns hold different values; the 2025 edition had neither test; and chart 33 of the report puts HTTPS redirect adoption among municipalities (95%) above HSTS (91%), the order of columns 3 and 4."@en ;
    prov:used d:snapshot-appendix,
        d:snapshot-report ;
    prov:wasAssociatedWith d:software-extract ;
    prov:wasInformedBy d:extraction-2026H1 .

d:snapshot-report a prov:Entity ;
    rdfs:label "Snapshot of the report 'Meting Informatieveiligheidstandaarden begin 2026'"@en ;
    dct:date "2026-10-01"^^xsd:date ;
    spdx:checksum [ a spdx:Checksum ;
            spdx:algorithm spdx:checksumAlgorithm_sha256 ;
            spdx:checksumValue "76ce99ed54f68f3045af964f0f624d0f5f1f837232be4cff7d9606809cc8ea6d"^^xsd:hexBinary ] ;
    prov:hadPrimarySource <https://www.forumstandaardisatie.nl/sites/default/files/OBDO/2026/0611/20260611-1a-rapport-meting-informatieveiligheidstandaarden-begin-2026-OBDO.html> .

