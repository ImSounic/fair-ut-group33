d:linking-2026H1 a prov:Activity ;
    rdfs:label "Attribution of hosts to municipalities"@en ;
    rdfs:comment "Rules version 1.0. 1867 hosts: R1 681, R2 333, R3 44, R4 329, ambiguous 1, not attributed 479 (coverage 74.3%). The municipal set was checked against CBS 2026 (342 codes)."@en ;
    prov:qualifiedAssociation [ a prov:Association ;
            prov:agent d:software-attribute ;
            prov:hadPlan ont:R1-official-host,
                ont:R2-official-domain,
                ont:R3-name-domain,
                ont:R4-name-label ] ;
    prov:used d:export-cbs-gemeenten-2026,
        d:export-wikidata-municipalities,
        d:extracted-tables-2026H1 ;
    prov:wasAssociatedWith d:software-attribute .

d:label-correction-2026H1 a prov:Activity ;
    rdfs:label "Correction of two mislabelled web columns"@en ;
    rdfs:comment "In all 16 web tables of the appendix, columns 3 and 4 are labelled 'IPv6 web' and 'RPKI web', repeating the labels of columns 6 and 7. They are relabelled 'HTTPS redirect' and 'HSTS': the legend lists the web tests in that order; the duplicated columns hold different values; the 2025 edition had neither test; and chart 33 of the report puts HTTPS redirect adoption among municipalities (95%) above HSTS (91%), the order of columns 3 and 4."@en ;
    prov:used d:snapshot-appendix,
        d:snapshot-report ;
    prov:wasAssociatedWith d:software-extract ;
    prov:wasInformedBy d:extraction-2026H1 .

d:measurement-2026H1 a prov:Activity ;
    rdfs:label "Measurement of information security standards, begin 2026"@en,
        "Meting Informatieveiligheidstandaarden begin 2026"@nl ;
    dct:source <https://www.forumstandaardisatie.nl/sites/default/files/OBDO/2026/0611/20260611-1a-rapport-meting-informatieveiligheidstandaarden-begin-2026-OBDO.html> ;
    dct:temporal [ a dct:PeriodOfTime ;
            dcat:endDate "2025-12-31"^^xsd:date ] ;
    rdfs:comment "Bulk test of government internet domains through the Internet.nl API. The results reflect the state on 31 December 2025; the source does not state the test dates, so the reference date is used as dct:date of every result."@en ;
    prov:wasAssociatedWith d:forum-standaardisatie,
        d:internetnl .

d:internetnl a earl:Software,
        prov:SoftwareAgent ;
    rdfs:comment "Open-source test suite for internet standards, used through its batch API. The release used for this measurement is not stated by the source."@en ;
    prov:actedOnBehalfOf d:forum-standaardisatie ;
    foaf:homepage <https://internet.nl/> ;
    foaf:name "Internet.nl" ;
    schema:sameAs wd:Q138768186 .

