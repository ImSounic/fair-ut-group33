<https://w3id.org/FAIR-course-UT/2026/group33/fdp/dataset/c1177570-7f8a-4c1d-af25-bbaea7bd4161>
  a dcat:Resource, dcat:Dataset;
  <http://www.w3.org/2000/01/rdf-schema#label> "Municipal results of the information security standards measurement, begin 2026";
  dcterms:title "Municipal results of the information security standards measurement, begin 2026"@en,
    "Gemeentelijke resultaten van de Meting Informatieveiligheidstandaarden begin 2026"@nl;
  dcat:version "1.0";
  <https://w3id.org/fdp/fdp-o#metadataIssued> "2026-10-21T23:46:44.012428154Z"^^xsd:dateTime;
  <https://w3id.org/fdp/fdp-o#metadataModified> "2026-10-22T01:04:41.064736456Z"^^xsd:dateTime;
  dcterms:license <http://creativecommons.org/publicdomain/zero/1.0/deed.nl>;
  dcterms:description "Per-host results of the begin-2026 edition of the measurement of mandatory internet security standards by Forum Standaardisatie for the internet domains of Dutch municipalities: 26,064 results of 14 tests (web: TLS, HTTPS redirect, HSTS, DNSSEC, IPv6, RPKI; e-mail: DKIM, DMARC, SPF, STARTTLS, DNSSEC MX, DANE, IPv6 MX, RPKI MX) for 1,867 hosts, reference date 31 December 2025. Each result is a W3C EARL assertion; hosts are attributed to municipalities (TOOI, Wikidata) by explicit rules and tests are linked to the standards they check (NORA). Two mislabelled columns of the source are corrected and one host name containing a personal name is excluded; both are recorded as provenance. The publisher intends a half-yearly measurement; no mid-2025 edition was published."@en,
    "Resultaten per host van de Meting Informatieveiligheidstandaarden begin 2026 van Forum Standaardisatie voor de internetdomeinen van Nederlandse gemeenten: 26.064 resultaten van 14 tests voor 1.867 hosts, peildatum 31 december 2025, als W3C EARL-beweringen, gekoppeld aan gemeenten (TOOI, Wikidata) en aan de standaarden die de tests toetsen (NORA)."@nl;
  dcterms:language <http://publications.europa.eu/resource/authority/language/ENG>,
    <http://publications.europa.eu/resource/authority/language/NLD>;
