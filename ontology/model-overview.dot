digraph overview {
  graph [rankdir=TB, fontname="Helvetica", nodesep=0.45, ranksep=0.55, pad=0.25, bgcolor="white"];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=15, penwidth=1.5, margin="0.18,0.10"];
  edge  [fontname="Helvetica", fontsize=12.5, color="#555555", fontcolor="#333333", arrowsize=0.8, penwidth=1.2];

  agent   [label=<<b>Internet.nl</b><br/><font point-size="11">software agent (PROV)</font>>, fillcolor="#fbe5cf", color="#c06a12"];
  meas    [label=<<b>Measurement begin 2026</b><br/><font point-size="11">activity, reference date 31-12-2025</font>>, fillcolor="#fbe5cf", color="#c06a12"];
  assert  [label=<<b>Test assertion</b><br/><font point-size="11">earl:Assertion · 26,064</font>>, fillcolor="#dbe9f6", color="#2f6fa8"];
  host    [label=<<b>Host</b><br/><font point-size="11">e.g. www.enschede.nl · 1,867</font>>, fillcolor="#e8def3", color="#6b4c9a"];
  test    [label=<<b>Test</b><br/><font point-size="11">e.g. HSTS · 14</font>>, fillcolor="#e8def3", color="#6b4c9a"];
  result  [label=<<b>Result</b><br/><font point-size="11">earl:TestResult</font>>, fillcolor="#dbe9f6", color="#2f6fa8"];
  code    [label=<<b>Outcome code</b><br/><font point-size="11">e.g. failed → earl:Fail · 10</font>>, fillcolor="#dff0dc", color="#3d8b37"];
  std     [label=<<b>Standard</b> (NORA)<br/><font point-size="11">e.g. HTTPS en HSTS → RFC 6797</font>>, fillcolor="#eeeeee", color="#777777"];
  attr    [label=<<b>Host attribution</b><br/><font point-size="11">rule R1–R4 · 1,388</font>>, fillcolor="#e8def3", color="#6b4c9a"];
  mun     [label=<<b>Municipality</b> (TOOI)<br/><font point-size="11">e.g. Enschede gm0153 · 342</font>>, fillcolor="#eeeeee", color="#777777"];
  prov    [label=<<b>Province</b><br/><font point-size="11">e.g. Overijssel · 12</font>>, fillcolor="#e8def3", color="#6b4c9a"];
  wd      [label=<<b>Wikidata item</b><br/><font point-size="11">schema:sameAs</font>>, fillcolor="#eeeeee", color="#777777"];

  assert -> agent [label=" asserted by "];
  assert -> host  [label=" subject "];
  assert -> test  [label=" test "];
  assert -> result [label=" result "];
  result -> code  [label=" outcome "];
  result -> meas  [label=" generated by "];
  test -> std     [label=" checks standard "];
  attr -> host    [label=" attributed host "];
  attr -> mun     [label=" attributed to "];
  mun -> host     [label=" website host /\n mail domain ", style=dashed];
  mun -> prov     [label=" in province "];
  mun -> wd       [label=" same as "];
  { rank=same; agent; host; test; result; }
  { rank=same; attr; std; meas; code; }
}
